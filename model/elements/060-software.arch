displayName "Software"
description "The systems, their containers and the systems outside."

element archmeta {
  type "c4:softwaresystem"
  displayName "ArchMeta"
  description-file "archmeta.md"
  sequence-file "first-start-of-archmeta.sequence"
}

element desktop-launcher {
  type "c4:container"
  displayName "Desktop launcher"
  description-file "desktop-launcher.md"
}

element kernel {
  type "c4:container"
  displayName "Kernel"
  description-file "kernel.md"
}

element viewer {
  type "c4:container"
  displayName "Viewer"
  description-file "viewer.md"
}

element publisher {
  type "c4:container"
  displayName "Publisher"
  description-file "publisher.md"
}

element public-website {
  type "c4:softwaresystem"
  displayName "Public website"
  description-file "public-website.md"
}

element public-site {
  type "c4:container"
  displayName "Public site"
  description-file "public-site.md"
}

element licensing {
  type "c4:softwaresystem"
  displayName "Licensing"
  description-file "licensing.md"
}

element licence-signer {
  type "c4:container"
  displayName "Licence signer"
  description-file "licence-signer.md"
}

element build-pipeline {
  type "c4:softwaresystem"
  displayName "Build pipeline"
  description-file "build-pipeline.md"
}

element source-repository {
  type "c4:container"
  displayName "Source repository"
  description-file "source-repository.md"
}

element build-job {
  type "c4:container"
  displayName "Build job"
  description-file "build-job.md"
}

element email-service {
  type "c4:externalsystem"
  displayName "Email service"
  description-file "email-service.md"
}

relationship source-repository-realization-source-control {
  source source-repository
  target source-control
  type "c4:realization"
}

relationship viewer-realization-model-authoring {
  source viewer
  target model-authoring
  type "c4:realization"
}

relationship publisher-realization-site-generation {
  source publisher
  target site-generation
  type "c4:realization"
}

relationship build-job-realization-build-and-release {
