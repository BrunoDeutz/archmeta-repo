displayName "Application"
description "The application services and the data they handle."

element source-control {
  type "archimate:applicationservice"
  displayName "Source control"
  description-file "source-control.md"
}

element build-and-release {
  type "archimate:applicationservice"
  displayName "Build and release"
  description-file "build-and-release.md"
}

element site-publishing {
  type "archimate:applicationservice"
  displayName "Site publishing"
  description-file "site-publishing.md"
}

element licence-issuing {
  type "archimate:applicationservice"
  displayName "Licence issuing"
  description-file "licence-issuing.md"
}

element mail-handling {
  type "archimate:applicationservice"
  displayName "Mail handling"
  description-file "mail-handling.md"
}

element model-authoring {
  type "archimate:applicationservice"
  displayName "Model authoring"
  description-file "model-authoring.md"
}

element site-generation {
  type "archimate:applicationservice"
  displayName "Site generation"
  description-file "site-generation.md"
}

element licence-file {
  type "archimate:dataobject"
  displayName "Licence file"
  description-file "licence-file.md"
}

element release-package {
  type "archimate:dataobject"
  displayName "Release package"
  description-file "release-package.md"
}

element architecture-repository {
  type "archimate:dataobject"
  displayName "Architecture repository"
  description-file "architecture-repository.md"
}

relationship source-control-serving-develop-a-feature {
  source source-control
  target develop-a-feature
  type "archimate:serving"
}

relationship model-authoring-serving-describe-the-architecture {
  source model-authoring
  target describe-the-architecture
  type "archimate:serving"
}

relationship site-generation-serving-describe-the-architecture {
  source site-generation
  target describe-the-architecture
  type "archimate:serving"
}

relationship build-and-release-serving-release-a-version {
  source build-and-release
  target release-a-version
  type "archimate:serving"
}

relationship site-publishing-serving-publish-the-website {
  source site-publishing
  target publish-the-website
  type "archimate:serving"
}

relationship licence-issuing-serving-issue-a-licence-by-hand {
  source licence-issuing
  target issue-a-licence-by-hand
  type "archimate:serving"
}

relationship mail-handling-serving-issue-a-licence-by-hand {
  source mail-handling
  target issue-a-licence-by-hand
  type "archimate:serving"
}

relationship mail-handling-serving-deliver-a-build-by-mail {
  source mail-handling
  target deliver-a-build-by-mail
  type "archimate:serving"
}

relationship mail-handling-serving-answer-a-support-request {
  source mail-handling
  target answer-a-support-request
  type "archimate:serving"
}

relationship licence-file-realization-licence {
  source licence-file
  target licence
  type "archimate:realization"
}

relationship release-package-realization-release {
  source release-package
  target release
  type "archimate:realization"
}

relationship architecture-repository-realization-repository {
  source architecture-repository
  target repository
  type "archimate:realization"
}

relationship licence-issuing-access-licence-file {
  source licence-issuing
  target licence-file
  type "archimate:access"
}

relationship build-and-release-access-release-package {
  source build-and-release
  target release-package
  type "archimate:access"
}

relationship model-authoring-access-architecture-repository {
  source model-authoring
  target architecture-repository
  type "archimate:access"
}

relationship site-generation-access-architecture-repository {
  source site-generation
  target architecture-repository
  type "archimate:access"
}

relationship website-data-licence-association-licence-file {
  source website-data.licence
  target licence-file
  type "data:association"
}

relationship repository-data-model-element-association-architecture-repository {
  source repository-data.model-element
  target architecture-repository
  type "data:association"
}

