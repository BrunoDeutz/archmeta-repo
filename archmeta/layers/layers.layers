layers availability-down {
  displayName "Availability Down"
  description "What relies on what, from the business down to the infrastructure: the way a requirement travels"
  layer "Capability" archimate:capability, archimate:courseofaction, archimate:valuestream
  layer "Capability Resource" archimate:resource
  layer "Business Service" archimate:businessservice
